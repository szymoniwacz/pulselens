#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ ! -f .env ]]; then
  cp .env.example .env
  echo "Created .env. Set POSTGRES_PASSWORD and CLICKHOUSE_PASSWORD before starting dependencies; then rerun bin/setup."
  exit 1
fi
set -a
source .env
set +a
: "${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in .env}"
: "${CLICKHOUSE_PASSWORD:?Set CLICKHOUSE_PASSWORD in .env}"
bundle config set --local path vendor/bundle
bundle install
docker compose up -d --wait
bin/rails db:prepare
RAILS_ENV=test bin/rails db:prepare
RAILS_ENV=development bin/rails clickhouse:setup
RAILS_ENV=test bin/rails clickhouse:setup
